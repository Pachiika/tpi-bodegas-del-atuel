// Bodegas del Atuel - modelo corregido (pegar en dbdiagram.io)

Enum estado_ingreso {
  en_confeccion
  terminado
  procesado
}

Enum estado_transferencia {
  en_confeccion
  terminado
  procesado
}

Table localidad {
  codigo_postal VARCHAR(10) [pk]
  nombre VARCHAR(80) [not null]
  provincia VARCHAR(80) [not null]
  encargado_regional VARCHAR(120) [not null]
}

Table finca {
  id_finca SERIAL [pk]
  nombre VARCHAR(80) [not null]
  superficie_ha NUMERIC(8,2) [not null]
  departamento VARCHAR(80) [not null]
  provincia VARCHAR(80) [not null]
}

Table cepa {
  id_cepa SERIAL [pk]
  nombre VARCHAR(50) [not null, unique]
  tipo VARCHAR(50) [not null]
}

Table parcela {
  id_finca INT [not null]
  nro_parcela INT [not null]
  superficie_ha NUMERIC(8,2) [not null]
  anio_plantacion INT [not null]
  id_cepa INT [not null]

  indexes {
    (id_finca, nro_parcela) [pk]
  }

  Note: 'ENTIDAD DÉBIL de finca: su clave (id_finca, nro_parcela) incluye la clave de finca. Si se borra la finca se borran sus parcelas (ON DELETE CASCADE).'
}

Table bodega {
  cuit VARCHAR(11) [pk]
  razon_social VARCHAR(120) [not null]
  domicilio VARCHAR(150) [not null]
}

Table lote_uva {
  nro_lote SERIAL [pk]
  id_finca INT [not null]
  nro_parcela INT [not null]
  campania INT [not null]
  fecha_cosecha DATE [not null]
  kilos_cosechados NUMERIC(10,2) [not null]
  cuit_bodega_destino VARCHAR(11) [not null]
}

Table analisis_calidad {
  id_analisis SERIAL [pk]
  nro_lote INT [not null]
  fecha DATE [not null]
  grado_brix NUMERIC(5,2) [not null]
  ph NUMERIC(4,2) [not null]
  acidez_total NUMERIC(5,2) [not null]
}

Table maridaje {
  id_maridaje SERIAL [pk]
  nombre VARCHAR(80) [not null]
  temperatura_servicio INT [not null]
}

Table vino {
  cod_vino SERIAL [pk]
  nombre VARCHAR(100) [not null]
  tipo VARCHAR(20) [not null]
  anada INT [not null]
  volumen_ml INT [not null]
  graduacion NUMERIC(4,2) [not null]
  precio NUMERIC(10,2) [not null]
  cuit_bodega VARCHAR(11) [not null]
}

Table composicion_vino {
  cod_vino INT [not null]
  id_cepa INT [not null]
  porcentaje INT [not null]

  indexes {
    (cod_vino, id_cepa) [pk]
  }

  Note: 'Relación N:M vino-cepa CON ATRIBUTO (porcentaje). Los porcentajes de un vino suman 100.'
}

Table vino_maridaje {
  cod_vino INT [not null]
  id_maridaje INT [not null]

  indexes {
    (cod_vino, id_maridaje) [pk]
  }

  Note: 'Relación N:M vino-maridaje.'
}

Table stock_deposito {
  cod_vino INT [pk]
  cantidad INT [not null]
}

Table auditoria_precio {
  id_auditoria SERIAL [pk]
  cod_vino INT [not null]
  precio_anterior NUMERIC(10,2) [not null]
  precio_nuevo NUMERIC(10,2) [not null]
  fecha_hora TIMESTAMP [not null]
  usuario VARCHAR(50) [not null]
}

Table sala_venta {
  id_sala SERIAL [pk]
  calle VARCHAR(80) [not null]
  numero VARCHAR(10) [not null]
  dia_cierre VARCHAR(15) [not null]
  cp_localidad VARCHAR(10) [not null]
}

Table empleado {
  cuit VARCHAR(11) [pk]
  nombre VARCHAR(120) [not null]
  fecha_ingreso DATE [not null]
  salario NUMERIC(10,2) [not null]
  id_sala INT [not null]
}

Table stock_sala {
  id_sala INT [not null]
  cod_vino INT [not null]
  cantidad INT [not null]

  indexes {
    (id_sala, cod_vino) [pk]
  }

  Note: 'Relación N:M sala-vino CON ATRIBUTO (cantidad).'
}

Table cliente {
  id_cliente SERIAL [pk]
  nombre_o_razon_social VARCHAR(120) [not null]
  tipo_doc VARCHAR(10) [not null]
  nro_doc VARCHAR(20) [not null]
  direccion VARCHAR(150) [not null]
  cp_localidad VARCHAR(10) [not null]
  fecha_alta DATE [not null]
  tipo_cliente VARCHAR(20) [not null]
  descuento NUMERIC(5,2) [not null]
  zona_cobertura VARCHAR(80)
  nro_habilitacion VARCHAR(50)
  pais_destino_principal VARCHAR(80)

  indexes {
    (tipo_doc, nro_doc) [unique]
  }

  Note: 'JERARQUÍA Cliente -> socio / distribuidor / exportador (total y disjunta). Se implementa en UNA sola tabla: tipo_cliente indica el subtipo; zona_cobertura y nro_habilitacion son solo del distribuidor y pais_destino_principal solo del exportador (NULL en los demas, controlado con CHECK).'
}

Table permiso_exportacion {
  codigo VARCHAR(30) [pk]
  id_cliente INT [not null]
  fecha_emision DATE [not null]
  fecha_vencimiento DATE [not null]

  Note: 'Solo para clientes de tipo exportador.'
}

Table transportista {
  codigo_transporte SERIAL [pk]
  razon_social VARCHAR(120) [not null]
  cuit VARCHAR(11) [not null, unique]
  email VARCHAR(100) [not null]
  telefono VARCHAR(30) [not null]
  domicilio VARCHAR(150) [not null]
}

Table transportista_cubre_localidad {
  codigo_transporte INT [not null]
  cp_localidad VARCHAR(10) [not null]

  indexes {
    (codigo_transporte, cp_localidad) [pk]
  }

  Note: 'Relación N:M transportista-localidad.'
}

Table comprobante {
  nro_comprobante SERIAL [pk]
  fecha TIMESTAMP [not null]
  id_cliente INT [not null]
  id_sala INT [not null]
  subtotal NUMERIC(12,2) [not null]
  descuento NUMERIC(12,2) [not null]
  total NUMERIC(12,2) [not null]

  Note: 'subtotal, descuento y total son DERIVADOS de los renglones; se guardan para no recalcular y se controla total = subtotal - descuento.'
}

Table renglon_comprobante {
  nro_comprobante INT [not null]
  cod_vino INT [not null]
  cantidad INT [not null]
  precio_unitario NUMERIC(10,2) [not null]
  descuento_aplicado NUMERIC(5,2) [not null]
  subtotal NUMERIC(12,2) [not null]

  indexes {
    (nro_comprobante, cod_vino) [pk]
  }
}

Table ingreso {
  codigo_ingreso SERIAL [pk]
  fecha TIMESTAMP [not null]
  estado estado_ingreso [not null, default: 'en_confeccion']
  codigo_transporte INT [not null]
  cuit_bodega VARCHAR(11) [not null]
}

Table renglon_ingreso {
  codigo_ingreso INT [not null]
  cod_vino INT [not null]
  cantidad INT [not null]

  indexes {
    (codigo_ingreso, cod_vino) [pk]
  }
}

Table transferencia {
  nro_transferencia SERIAL [pk]
  id_sala INT [not null]
  fecha_confeccion TIMESTAMP [not null]
  estado estado_transferencia [not null, default: 'en_confeccion']
}

Table renglon_transferencia {
  nro_transferencia INT [not null]
  cod_vino INT [not null]
  cantidad INT [not null]

  indexes {
    (nro_transferencia, cod_vino) [pk]
  }
}

Ref: parcela.id_finca > finca.id_finca
Ref: parcela.id_cepa > cepa.id_cepa
Ref: lote_uva.(id_finca, nro_parcela) > parcela.(id_finca, nro_parcela)
Ref: lote_uva.cuit_bodega_destino > bodega.cuit
Ref: analisis_calidad.nro_lote > lote_uva.nro_lote
Ref: vino.cuit_bodega > bodega.cuit
Ref: composicion_vino.cod_vino > vino.cod_vino
Ref: composicion_vino.id_cepa > cepa.id_cepa
Ref: vino_maridaje.cod_vino > vino.cod_vino
Ref: vino_maridaje.id_maridaje > maridaje.id_maridaje
Ref: stock_deposito.cod_vino > vino.cod_vino
Ref: auditoria_precio.cod_vino > vino.cod_vino
Ref: sala_venta.cp_localidad > localidad.codigo_postal
Ref: empleado.id_sala > sala_venta.id_sala
Ref: stock_sala.id_sala > sala_venta.id_sala
Ref: stock_sala.cod_vino > vino.cod_vino
Ref: cliente.cp_localidad > localidad.codigo_postal
Ref: permiso_exportacion.id_cliente > cliente.id_cliente
Ref: transportista_cubre_localidad.codigo_transporte > transportista.codigo_transporte
Ref: transportista_cubre_localidad.cp_localidad > localidad.codigo_postal
Ref: comprobante.id_cliente > cliente.id_cliente
Ref: comprobante.id_sala > sala_venta.id_sala
Ref: renglon_comprobante.nro_comprobante > comprobante.nro_comprobante
Ref: renglon_comprobante.cod_vino > vino.cod_vino
Ref: ingreso.codigo_transporte > transportista.codigo_transporte
Ref: ingreso.cuit_bodega > bodega.cuit
Ref: renglon_ingreso.codigo_ingreso > ingreso.codigo_ingreso
Ref: renglon_ingreso.cod_vino > vino.cod_vino
Ref: transferencia.id_sala > sala_venta.id_sala
Ref: renglon_transferencia.nro_transferencia > transferencia.nro_transferencia
Ref: renglon_transferencia.cod_vino > vino.cod_vino
