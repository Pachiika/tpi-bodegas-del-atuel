# Copiar como .env y cambiar TODAS las contraseñas. El archivo .env no se sube a Git.
# Usar contraseñas sin espacios ni comillas (letras, números, - y _).

# Superusuario del contenedor (solo para administrar; la API no lo usa)
POSTGRES_PASSWORD=cambiar-superusuario
# Propietario del esquema (migraciones y carga masiva)
BODEGA_OWNER_PASSWORD=cambiar-owner
# Rol de lectura/escritura que usa la API
APP_RW_PASSWORD=cambiar-app-rw
# Rol de solo lectura (consultas, reportes)
APP_RO_PASSWORD=cambiar-app-ro

# Puerto local de PostgreSQL (cambiar si ya hay un Postgres instalado en 5432)
DB_PUERTO_LOCAL=5432
# URL de la API vista desde el navegador (en la nube: https://api.midominio.com)
API_URL_PUBLICA=http://localhost:8000
# Orígenes permitidos por CORS (en la nube: la URL del front)
CORS_ORIGINS=*
# Fecha "de hoy" para generar el dataset (AAAA-MM-DD). Vacío = 2026-11-01.
# Poner la fecha de la defensa para que "última semana" / "último mes" den resultados.
SEED_FECHA_REFERENCIA=
